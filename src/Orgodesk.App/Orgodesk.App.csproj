<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Orgodesk.App</RootNamespace>
    <AssemblyName>Orgodesk</AssemblyName>
    <!-- Semantic Versioning (MAJOR.MINOR.PATCH); see CHANGELOG.md and HQ/testing/PRODUCTION.md section 3. -->
    <Version>1.0.1</Version>
    <Product>Orgodesk</Product>
    <Company>CRC Solutions</Company>
    <Copyright>Copyright (c) 2026 CRC Solutions</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orgodesk.Core\Orgodesk.Core.csproj" />
    <ProjectReference Include="..\Orgodesk.Windows\Orgodesk.Windows.csproj" />
    <ProjectReference Include="..\Orgodesk.Commands\Orgodesk.Commands.csproj" />
    <!-- The AI-connection gate (crc-appshell kit-1.10, D-11) and its key window. Orgodesk's own app licence stays in
         Orgodesk.Core.Licensing for now (ISSUES.md FC-56). -->
    <ProjectReference Include="..\..\..\..\libs\crc-appshell\src\Crc.AppShell.WinForms\Crc.AppShell.WinForms.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Orgodesk.Commands.Tests" />
  </ItemGroup>
</Project>
