<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Orgodesk.App</RootNamespace>
    <AssemblyName>Orgodesk</AssemblyName>
    <!-- Semantic Versioning (MAJOR.MINOR.PATCH); see CHANGELOG.md and HQ/testing/PRODUCTION.md section 3. -->
    <Version>1.1.0</Version>
    <Product>Orgodesk</Product>
    <Company>CRC Solutions</Company>
    <Copyright>Copyright (c) 2026 CRC Solutions</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- FC-64: the single-file exe is 103 MB uncompressed and 47 MB compressed. The first start of an exe the PC has not seen is
         spent before Main (Windows Defender reads the whole file), so a smaller file starts the first time sooner: 2.5 to 3.7 s
         against 3.5 to 5.5 s cold on the same VM, 0.1 s more on a warm start. Only applies to the single-file publish. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orgodesk.Core\Orgodesk.Core.csproj" />
    <ProjectReference Include="..\Orgodesk.Windows\Orgodesk.Windows.csproj" />
    <ProjectReference Include="..\Orgodesk.Commands\Orgodesk.Commands.csproj" />
    <!-- The AI-connection gate (crc-appshell kit-1.10, D-11) and its key window. Orgodesk's own app licence stays in
         Orgodesk.Core.Licensing for now (ISSUES.md FC-56). -->
    <ProjectReference Include="..\..\..\..\libs\crc-appshell\src\Crc.AppShell.WinForms\Crc.AppShell.WinForms.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Orgodesk.Commands.Tests" />
  </ItemGroup>
</Project>
