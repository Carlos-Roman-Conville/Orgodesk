<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <!-- publish.bat and release.bat publish with -r; keep that restore's lock file out of the tracked one. -->
    <NuGetLockFilePath>$(MSBuildProjectDirectory)\obj\packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
